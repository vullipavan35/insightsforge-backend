# ==========================================
# InsightForge Backend - Environment Template
# ==========================================

ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=DEBUG

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://localhost:5432/insightsforge_dev

# Redis Cache & Background Tasks
REDIS_URL=redis://localhost:6379/0

# Security & JWT
SECRET_KEY=change-this-insecure-dev-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# File Upload Limits & Storage
FILE_UPLOAD_DIR=./uploads/dev
MAX_FILE_SIZE_MB=500

# Feature Flags
ENABLE_API_DOCS=True
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=60
