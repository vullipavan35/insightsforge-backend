# Server
PORT=5000
JWT_SECRET=insightforge-dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# Database (SQLite path for local dev)
DATABASE_PATH=./db/insightforge.db

# Razorpay (Test Mode — get keys from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
